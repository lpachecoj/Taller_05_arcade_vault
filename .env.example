# Copia este archivo a .env.local y completa los valores reales.
# Nunca commitees .env.local.

# API key de Resend (https://resend.com/api-keys). Solo servidor: sin prefijo NEXT_PUBLIC_.
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto.
# Con el remitente onboarding@resend.dev, Resend solo entrega al correo de la cuenta de Resend.
CONTACT_TO_EMAIL=
